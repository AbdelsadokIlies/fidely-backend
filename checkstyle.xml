<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Configuration Checkstyle - Fidely Backend
    Objectif principal : imposer la présence de Javadoc sur les classes,
    interfaces et méthodes publiques, en plus d'un socle de règles de style
    courantes (imports, longueur de ligne, accolades...).

    Utilisation : mvn checkstyle:check
    Rapport HTML : mvn checkstyle:checkstyle (généré dans target/site)
-->
<module name="Checker">

    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Ignore les fichiers générés (ex : MapStruct, QueryDSL) -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="module\-info\.java$"/>
    </module>

    <!-- Pas de tabulations -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Longueur de ligne raisonnable -->
    <module name="LineLength">
        <property name="max" value="130"/>
        <property name="ignorePattern" value="^import\s.*$|^package\s.*$"/>
    </module>

    <module name="TreeWalker">

        <!-- ================= JAVADOC : le cœur de la config ================= -->

        <!-- Toute classe / interface / enum / record publique doit avoir une Javadoc -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
            <property name="tokens"
                      value="INTERFACE_DEF, CLASS_DEF, ENUM_DEF, ANNOTATION_DEF, RECORD_DEF"/>
        </module>

        <!-- Toute méthode publique doit avoir une Javadoc -->
        <!-- allowedAnnotations = on n'exige pas de doc sur les méthodes @Override / @Bean simples -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="allowedAnnotations" value="Override, Bean, PostConstruct, PreDestroy"/>
            <!-- Ignore les getters/setters triviaux d'une seule ligne -->
            <property name="minLineCount" value="2"/>
            <property name="allowMissingPropertyJavadoc" value="true"/>
        </module>

        <!-- Vérifie la cohérence des tags @param / @return / @throws quand ils existent -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowMissingReturnTag" value="false"/>
            <property name="allowedAnnotations" value="Override, Bean"/>
        </module>

        <!-- La Javadoc de type doit rester cohérente (ex: pas de @param sur une classe non générique mal utilisé) -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
        </module>

        <!-- Exige une vraie phrase de résumé en première ligne de la Javadoc -->
        <module name="SummaryJavadoc">
            <property name="forbiddenSummaryFragments"
                      value="^@return the|^This method returns"/>
        </module>

        <!-- Interdit les @param / @return / @throws sans description -->
        <module name="NonEmptyAtclauseDescription"/>

        <!-- Ordre logique des tags Javadoc (@param avant @return avant @throws...) -->
        <module name="AtclauseOrder">
            <property name="tagOrder" value="@param, @return, @throws, @deprecated, @see, @since"/>
        </module>

        <!-- Format correct des paragraphes Javadoc (ligne vide entre résumé et détails) -->
        <module name="JavadocParagraph"/>

        <!-- Pas de HTML mal fermé, balises correctement formées -->
        <module name="JavadocStyle">
            <property name="checkFirstSentence" value="true"/>
            <property name="checkEmptyJavadoc" value="true"/>
        </module>

        <!-- ================= IMPORTS ================= -->

        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>
        <module name="IllegalImport"/>

        <!-- ================= LISIBILITÉ / STYLE ================= -->

        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="WhitespaceAround"/>
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>

        <!-- ================= NOMMAGE ================= -->

        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>

        <!-- ================= TAILLE / COMPLEXITÉ ================= -->

        <module name="MethodLength">
            <property name="max" value="80"/>
        </module>
        <!--
        <module name="ParameterNumber">
            <property name="max" value="7"/>
        </module>
        -->

    </module>

</module>